# Timelife configuration. Copy this file to .env, fill in unique secrets and never commit .env.
# Docker Compose reads .env to fill in its variables; the backend also reads it when it runs
# outside Docker. Every setting is an upper-case environment variable.
# docker-compose.yml refuses to start unless POSTGRES_PASSWORD, AUTH_SECRET and PUBLIC_ORIGIN are
# set. The first person to open a new Timelife creates its administrator account (e-mail and
# password) from the login page.

# --- Database (docker-compose) -------------------------------------------------------------
# Password of the bundled PostgreSQL service; the app connects as user/database "timelife".
# It is embedded in the connection URL, so use a URL-safe value (the command below is fine).
# It only initialises a NEW database volume: changing it later does not change the password.
POSTGRES_PASSWORD=

# --- Security --------------------------------------------------------------------------------
# HMAC key for sessions and sign-in state; at least 32 characters. Changing it signs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Browser origin(s) of the app: one URL or a comma-separated list, for example
# https://timelife.example.com,https://timelife.home.example.com
# No credentials, paths, queries or wildcards. With AUTH_COOKIE_SECURE=true every origin that is
# not localhost / 127.0.0.1 / [::1] must use HTTPS.
PUBLIC_ORIGIN=https://timelife.example.com
# Secure cookies and HSTS. Keep true in production (HTTPS); the local stack always uses false.
AUTH_COOKIE_SECURE=true

# --- Google sign-in (optional) ------------------------------------------------------------------
# E-mail and password sign-in always works. With these two values people can also use "Continuar
# con Google" with the e-mail an administrator gave access to.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (type: Web application).
# Authorized redirect URI, one per public origin: <PUBLIC_ORIGIN>/api/auth/google/callback
# e.g. https://timelife.example.com/api/auth/google/callback
# (local: http://localhost:7779/api/auth/google/callback). Set both values or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (optional) ----------------------------------------------------------------------------
# An SMTP server lets people who forgot their password get a link to choose a new one ("¿Has
# olvidado tu contraseña?" on the login page). Leave SMTP_HOST empty to turn it off.
# Check the settings with: docker compose exec app python -m timelife.mail you@example.com
SMTP_HOST=
# starttls (port 587 by default), ssl (465) or none (25, only for a relay on your own network).
SMTP_SECURITY=starttls
# Empty: the default port of SMTP_SECURITY.
SMTP_PORT=
# Credentials of the mailbox (both or neither; not allowed with SMTP_SECURITY=none). With Gmail,
# use an app password (Google account → Security → App passwords).
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender of the e-mails: an address or "Name <address>", e.g. "Timelife <timelife@example.com>"
# (quoted). Many providers only accept the address of SMTP_USERNAME.
SMTP_FROM=

# Session lifetime in days (1-365) and maximum size of an uploaded photo in MB (1-200).
SESSION_DAYS=30
MAX_UPLOAD_MB=30
# Videos (event photos and videos): maximum size of one video in MB (1-4096) and its maximum
# length in minutes (1-240). Your reverse proxy must accept bodies of MAX_UPLOAD_MB +
# MAX_VIDEO_UPLOAD_MB (a Live Photo and its clip travel together).
MAX_VIDEO_UPLOAD_MB=500
MAX_VIDEO_MINUTES=10

# --- Local development stack (docker-compose.local.yml) ----------------------------------------
# The local stack ignores PUBLIC_ORIGIN and AUTH_COOKIE_SECURE: it listens on 127.0.0.1 only, over
# plain HTTP, with non-Secure cookies and the development login enabled. Google sign-in and SMTP
# are optional there too.
# Loopback origin(s) of the local stack: http://localhost, http://127.0.0.1 or http://[::1] only,
# including the port (change it together with APP_PORT).
LOCAL_PUBLIC_ORIGIN=http://localhost:7779
# Password of the development login (users "admin" and "viewer"); never enabled in production.
LOCAL_LOGIN_PASSWORD=admin

# --- Container -------------------------------------------------------------------------------
# Host port to publish (the container always listens on 7779).
APP_PORT=7779
# Image tag to run with docker-compose.yml (latest or a release such as 20261102).
IMAGE_TAG=latest
# Reverse proxies allowed to set X-Forwarded-* headers, as seen from inside the container
# (comma-separated IPs or networks, e.g. the Docker network gateway 172.18.0.1). Never use *.
TRUSTED_PROXY_IPS=127.0.0.1
# IANA time zone of the server.
TZ=Europe/Madrid

# --- Running the backend outside Docker (uv run uvicorn timelife.app:app --port 7779) -----------
# Also set PUBLIC_ORIGIN to the browser origin(s) you use, e.g. http://localhost:7779 or the Vite
# dev server http://localhost:5173, and AUTH_COOKIE_SECURE=false.
# DATABASE_URL=sqlite+aiosqlite:///./data/timelife.db
# MEDIA_DIR=./data/media
# ALLOW_INSECURE_LOCAL_LOGIN=true
