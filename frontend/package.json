{
  "name": "timelife-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview:demo": "vite preview --mode demo",
    "lint": "oxlint --deny-warnings src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:screenshots": "npm run build:demo && node scripts/gen-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
